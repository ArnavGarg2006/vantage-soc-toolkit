__pycache__/
*.pyc

# Captured traffic contains real local network data (device IPs/MACs) - never commit
shield-collect/captures/

# Generated demo artifacts - regenerated fresh each run
credential-access/scratch/
impact/scratch/
impact/recovery_key.bin
persistence/demo_log.txt
collection/scratch/
shield-legitimize/scratch/

# Event bus history - durable SQLite store that accumulates real alerts
# from THIS machine across sessions (real process/path details in some
# messages) - same privacy reasoning as shield-collect/captures/ above,
# never commit it
event-bus/events.db
realtime-detection/scratch/

# Baseline store - real (process, port) inventory specific to this
# machine, same privacy reasoning as events.db above
baseline-detection/baseline.db
ai-security/agent_baseline.db

# Official MITRE ATT&CK STIX bundle - ~48MB downloaded cache, not source
# we authored; attack_cti_lookup.py re-downloads it on first run
detection-engineering/attack-stix/

# Downloaded third-party training pcaps - real, large, and per the source
# site's own warning can trip AV scanners; fetch_training_pcap.py
# re-downloads on demand, never something to commit
shield-collect/training-pcaps/

# Generated report - carries a fresh timestamp every run, would just be
# repo-diff noise; regenerate with detection-engineering/generate_report.py
detection-engineering/security_report.html

# PyInstaller build output - rebuild with packaging/build.sh equivalent command;
# the .exe itself is large binary, regenerate rather than commit
packaging/build/
packaging/dist/
